---
import Icon from './Icon.astro';
import { base, site } from '../data/content';
---

<footer class="bg-night-950 py-14 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-accent-500 text-white">
            <Icon name="stethoscope" class="size-5" />
          </span>
          <span class="font-display text-sm font-bold text-white">{site.title}</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed">{site.tagline}. Sitio educativo de consulta rápida basado en el
          documento técnico oficial.</p>
      </div>

      <div>
        <h3 class="text-xs font-bold tracking-widest text-slate-200 uppercase">Fuentes normativas</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>Procedimiento de registro HIS MINSA · Documento Técnico {site.year}</li>
          <li>Directiva N° 002-2024-SIS/GREP-V.02 (FUA)</li>
          <li>Documento técnico de códigos por curso de vida 301-306</li>
          <li>Directiva N° 001-2025-SIS/GREP-V.01 (auditoría)</li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold tracking-widest text-slate-200 uppercase">Enlaces</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a
              href={site.bvsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 transition-colors hover:text-brand-300"
            >
              <Icon name="external" class="size-3.5" />
              Biblioteca Virtual en Salud — Manuales del HIS
            </a>
          </li>
          <li>
            <a href={site.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-brand-300">
              <Icon name="link" class="size-3.5" />
              Repositorio del proyecto
            </a>
          </li>
          <li>
            <a href={`${base}glosario/`} class="inline-flex items-center gap-2 transition-colors hover:text-brand-300">
              <Icon name="book" class="size-3.5" />
              Glosario del sistema de información
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-night-700 pt-6 text-xs sm:flex-row"
    >
      <p>{site.org} · {site.year}</p>
      <p>Fuente: {site.sourceDocument}</p>
    </div>
  </div>
</footer>
