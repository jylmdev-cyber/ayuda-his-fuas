---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { cursoVida } from '../data/content';
---

<section
  id="curso-vida"
  class="scroll-mt-24 border-y border-slate-200 bg-white py-20 sm:py-24 dark:border-night-700 dark:bg-night-900"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Bloque 3 · Modelo de cuidado integral"
      title="Códigos prestacionales por curso de vida"
      description={cursoVida.finalidad}
    />

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {cursoVida.codes.map((code) => (
        <article
          class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 p-6 text-center transition-all hover:-translate-y-1.5 hover:border-brand-400/70 hover:shadow-xl hover:shadow-brand-500/10 dark:border-night-700 dark:bg-night-800"
        >
          <div
            class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand-500 to-accent-500 opacity-0 transition-opacity group-hover:opacity-100"
            aria-hidden="true"
          ></div>
          <p
            class="font-display bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-5xl font-extrabold text-transparent"
          >
            {code.codigo}
          </p>
          <p class="mt-3 text-sm leading-snug font-semibold text-slate-800 dark:text-slate-100">{code.nombre}</p>
          <p class="mt-2 inline-block rounded-full bg-brand-500/15 px-3 py-1 text-[11px] font-semibold text-brand-700 dark:text-brand-300">
            {code.rango}
          </p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-center text-xs text-slate-500 dark:text-slate-400">{cursoVida.rangeNote}</p>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-8 dark:border-night-700 dark:bg-night-800">
        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Ámbito de aplicación</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{cursoVida.ambito}</p>
        <div
          class="mt-6 flex items-start gap-3 rounded-2xl border border-brand-500/30 bg-brand-500/10 p-4"
        >
          <Icon name="target" class="mt-0.5 size-4 shrink-0 text-brand-600 dark:text-brand-300" />
          <p class="text-xs leading-relaxed text-slate-700 dark:text-slate-300">
            Los códigos se registran en la sección <strong class="font-semibold">"DE LA ATENCIÓN"</strong>, campo
            <code class="rounded bg-white px-1.5 py-0.5 font-mono text-[11px] dark:bg-night-900">COD. PRESTA.</code>,
            consolidando en un solo código todas las intervenciones de la misma atención.
          </p>
        </div>
      </article>

      <ul class="space-y-3">
        {cursoVida.rules.map((rule) => (
          <li
            class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 transition-colors hover:border-brand-400/70 dark:border-night-700 dark:bg-night-800"
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-500/15 text-brand-600 dark:text-brand-300">
              <Icon name="shield" class="size-4" />
            </span>
            <div>
              <p class="text-sm font-bold text-slate-900 dark:text-white">{rule.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{rule.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
