---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { codeTables, productionFormulas } from '../data/content';
---

<section id="codigos" class="scroll-mt-24 border-y border-slate-200 bg-white py-20 sm:py-24 dark:border-night-700 dark:bg-night-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Tablas de codificación"
      title="Códigos que se registran en la Hoja HIS"
      description="Financiador, pertenencia étnica y condición de atención, tal como aparecen en el material oficial."
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {codeTables.map((table) => (
        <article
          class="flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 dark:border-night-700 dark:bg-night-800"
        >
          <header class="border-b border-slate-200 bg-white px-6 py-5 dark:border-night-700 dark:bg-night-800">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">{table.titulo}</h3>
              <span class="rounded-full bg-brand-500/15 px-3 py-1 text-[11px] font-bold text-brand-700 dark:text-brand-300">
                {table.itemRef}
              </span>
            </div>
            {table.fuente && <p class="mt-1.5 text-[11px] text-slate-500 dark:text-slate-400">{table.fuente}</p>}
          </header>
          <div class="flex-1 px-6 py-4">
            <table class="w-full text-sm">
              <tbody class="divide-y divide-slate-200 dark:divide-night-700">
                {table.rows.map((row) => (
                  <tr class="group">
                    <th
                      scope="row"
                      class="w-14 py-3 pr-3 text-left align-top font-mono text-base font-bold text-brand-600 dark:text-brand-300"
                    >
                      {row.code}
                    </th>
                    <td class="py-3">
                      <span class="font-semibold text-slate-800 dark:text-slate-100">{row.label}</span>
                      {row.note && (
                        <span class="mt-0.5 block text-xs leading-relaxed text-slate-500 dark:text-slate-400">{row.note}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {table.nota && (
            <footer class="flex gap-2 border-t border-slate-200 bg-amber-500/10 px-6 py-3 dark:border-night-700">
              <Icon name="alert" class="mt-0.5 size-3.5 shrink-0 text-amber-600 dark:text-amber-300" />
              <p class="text-xs leading-relaxed text-amber-800 dark:text-amber-200">{table.nota}</p>
            </footer>
          )}
        </article>
      ))}
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {[productionFormulas.intramural, productionFormulas.extramural].map((mode, i) => (
        <article
          class:list={[
            'rounded-3xl border p-8',
            i === 0
              ? 'border-brand-500/40 bg-brand-500/5 dark:bg-brand-500/10'
              : 'border-accent-500/40 bg-accent-500/5 dark:bg-accent-500/10',
          ]}
        >
          <div class="flex items-center gap-3">
            <span
              class:list={[
                'grid size-10 place-items-center rounded-xl text-white',
                i === 0 ? 'bg-brand-600' : 'bg-accent-500',
              ]}
            >
              <Icon name={i === 0 ? 'building' : 'map'} class="size-5" />
            </span>
            <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">
              {i + 1}. {mode.title}
            </h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{mode.detail}</p>
          <p class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-100">{mode.registro}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {mode.formulas.map((formula) => (
              <code
                class="rounded-lg bg-white px-3 py-1.5 font-mono text-xs font-semibold text-slate-800 shadow-sm dark:bg-night-900 dark:text-slate-100"
              >
                {formula}
              </code>
            ))}
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">{productionFormulas.intro}</p>
  </div>
</section>
