---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { dataFlow, his } from '../data/content';
---

<section id="hoja" class="scroll-mt-24 border-y border-slate-200 bg-white py-20 sm:py-24 dark:border-night-700 dark:bg-night-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Instrumento de recojo de datos"
      title="La Hoja HIS y su circuito"
      description="Registro Diario de Atención y Otras Actividades de Salud: dos secciones, casilleros numerados y hasta 22 ítems por hoja."
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-8 dark:border-night-700 dark:bg-night-800">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-2xl bg-brand-500/15 text-brand-600 dark:text-brand-300">
            <Icon name="clipboard" class="size-6" />
          </span>
          <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">{his.instrument.name}</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{his.instrument.detail}</p>

        <h4 class="mt-6 text-xs font-semibold tracking-widest text-slate-500 uppercase dark:text-slate-400">
          Organización de lotes
        </h4>
        <dl class="mt-3 grid gap-3 sm:grid-cols-2">
          {his.structure.map((item) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-night-600 dark:bg-night-900/60">
              <dt class="text-sm font-semibold text-brand-700 dark:text-brand-300">{item.term}</dt>
              <dd class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{item.def}</dd>
            </div>
          ))}
        </dl>
      </article>

      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-8 dark:border-night-700 dark:bg-night-800">
        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Uso correcto de la Hoja HIS</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          La utilizan todos los profesionales, técnicos y auxiliares que brindan atención directa en consulta externa,
          actividades preventivas y promocionales (APP) y actividades relacionadas con animales (AAA).
        </p>
        <ul class="mt-5 space-y-3">
          {his.usageRules.map((rule) => (
            <li class="flex gap-3 rounded-2xl border border-slate-200 bg-white p-4 dark:border-night-600 dark:bg-night-900/60">
              <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-500" />
              <div>
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">{rule.title}</p>
                <p class="mt-0.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{rule.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="mt-16">
      <h3 class="font-display text-center text-2xl font-bold text-slate-900 dark:text-white">
        Flujo del dato: del consultorio al archivo
      </h3>
      <ol class="relative mx-auto mt-10 max-w-3xl space-y-6 border-l-2 border-dashed border-brand-500/40 pl-8">
        {dataFlow.map((step) => (
          <li class="relative">
            <span
              class="absolute top-1 -left-[41px] grid size-6 place-items-center rounded-full border-2 border-brand-500 bg-white text-brand-600 dark:bg-night-900 dark:text-brand-300"
              aria-hidden="true"
            >
              <Icon name={step.icon} class="size-3" />
            </span>
            <div
              class="rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-brand-400/70 dark:border-night-700 dark:bg-night-800"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm font-bold text-slate-900 dark:text-white">{step.title}</p>
                <span
                  class="rounded-full bg-brand-500/15 px-3 py-1 text-[11px] font-semibold text-brand-700 dark:text-brand-300"
                >
                  {step.when}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {[
        { icon: 'check' as const, title: 'Control de calidad', text: his.quality },
        { icon: 'clock' as const, title: 'Fecha de envío', text: his.sendDate },
        { icon: 'target' as const, title: 'Monitoreo', text: his.monitoring },
      ].map((card) => (
        <article
          class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition-all hover:-translate-y-1 hover:border-brand-400/70 dark:border-night-700 dark:bg-night-800"
        >
          <span class="grid size-10 place-items-center rounded-xl bg-accent-500/15 text-accent-500 dark:text-accent-300">
            <Icon name={card.icon} class="size-5" />
          </span>
          <h4 class="font-display mt-4 text-base font-bold text-slate-900 dark:text-white">{card.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{card.text}</p>
        </article>
      ))}
    </div>

    <p
      class="mx-auto mt-10 max-w-4xl rounded-2xl border border-brand-500/30 bg-brand-500/10 p-5 text-center text-sm leading-relaxed text-slate-700 dark:text-slate-300"
    >
      <strong class="font-semibold text-brand-700 dark:text-brand-300">Responsabilidad del registro:</strong>
      {his.responsibility}
    </p>
  </div>
</section>
