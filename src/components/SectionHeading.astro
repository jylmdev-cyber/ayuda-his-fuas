---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">
  <span
    class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-semibold tracking-widest text-brand-700 uppercase dark:text-brand-300"
  >
    {eyebrow}
  </span>
  <h2 class="font-display mt-4 text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">
    {title}
  </h2>
  {description && <p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>}
</div>
