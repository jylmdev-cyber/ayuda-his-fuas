---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { auditoria } from '../data/content';
---

<section id="auditoria" class="scroll-mt-24 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={`Bloque 4 · ${auditoria.norma}`}
      title="Auditoría de seguros del SIS"
      description={auditoria.vigencia}
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      <article
        class="rounded-3xl border border-slate-200 bg-white p-8 lg:col-span-2 dark:border-night-700 dark:bg-night-800"
      >
        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">{auditoria.titulo}</h3>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-xs font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300">Finalidad</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{auditoria.finalidad}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300">Objetivo general</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{auditoria.objetivoGeneral}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300">Ámbito de aplicación</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{auditoria.ambito}</dd>
          </div>
        </dl>
      </article>

      <div class="space-y-4">
        {auditoria.procesos.map((proceso, i) => (
          <article
            class="flex items-start gap-4 rounded-3xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-accent-400/70 dark:border-night-700 dark:bg-night-800"
          >
            <span
              class="font-display grid size-11 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-accent-500 to-brand-500 text-lg font-bold text-white"
            >
              {i + 1}
            </span>
            <div>
              <h4 class="font-display text-base font-bold text-slate-900 dark:text-white">{proceso.nombre}</h4>
              <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{proceso.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <article class="mt-10 rounded-3xl border border-rose-500/30 bg-rose-500/5 p-8 dark:bg-rose-500/10">
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-rose-500/15 text-rose-600 dark:text-rose-300">
          <Icon name="close" class="size-5" />
        </span>
        <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">
          Directivas que deja sin efecto
        </h3>
      </div>
      <ul class="mt-5 grid gap-3 lg:grid-cols-3">
        {auditoria.derogadas.map((derogada) => (
          <li
            class="rounded-2xl border border-rose-500/20 bg-white p-4 text-xs leading-relaxed text-slate-600 line-through decoration-rose-400/70 dark:bg-night-900/60 dark:text-slate-400"
          >
            {derogada}
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
