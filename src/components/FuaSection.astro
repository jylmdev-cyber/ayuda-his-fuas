---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { fua } from '../data/content';
---

<section id="fua" class="scroll-mt-24 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={`Bloque 2 · ${fua.norma}`}
      title="Formato Único de Atención (FUA) del SIS"
      description={fua.vigencia}
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      <article
        class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 lg:col-span-2 dark:border-night-700 dark:bg-night-800"
      >
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-accent-500 to-brand-500" aria-hidden="true"></div>
        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">{fua.titulo}</h3>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-xs font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300">Finalidad</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{fua.finalidad}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300">Objetivo</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{fua.objetivo}</dd>
          </div>
        </dl>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {fua.definitions.map((definition) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-night-600 dark:bg-night-900/60">
              <p class="text-sm font-bold text-slate-900 dark:text-white">{definition.term}</p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{definition.def}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-slate-200 bg-white p-8 dark:border-night-700 dark:bg-night-800">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-300">
            <Icon name="alert" class="size-5" />
          </span>
          <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">Reglas de oro del FUA</h3>
        </div>
        <p class="mt-3 rounded-xl bg-amber-500/10 px-4 py-2.5 text-xs font-semibold text-amber-800 dark:text-amber-200">
          El FUA tiene carácter de DECLARACIÓN JURADA.
        </p>
        <ul class="mt-4 space-y-3">
          {fua.rules.map((rule) => (
            <li class="flex gap-2.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-brand-500" />
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="mt-14">
      <h3 class="font-display text-center text-2xl font-bold text-slate-900 dark:text-white">
        Los 17 campos del Formato Único de Atención
      </h3>
      <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-slate-500 dark:text-slate-400">
        Despliega cada campo para ver qué se registra. La numeración sigue las diapositivas del documento técnico.
      </p>
      <ul class="mx-auto mt-8 max-w-4xl space-y-2.5">
        {fua.fields.map((field) => (
          <li>
            <details
              class="group rounded-2xl border border-slate-200 bg-white transition-colors open:border-accent-400/70 dark:border-night-700 dark:bg-night-800 dark:open:border-accent-500/50"
            >
              <summary
                class="flex cursor-pointer items-center gap-4 rounded-2xl px-5 py-3.5 select-none [&::-webkit-details-marker]:hidden"
              >
                <span
                  class="font-display grid size-8 shrink-0 place-items-center rounded-lg bg-accent-500/15 text-xs font-bold text-accent-600 dark:text-accent-300"
                >
                  {field.num}
                </span>
                <span class="flex-1 text-sm font-semibold text-slate-800 dark:text-slate-100">{field.nombre}</span>
                <Icon name="chevron" class="size-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
              </summary>
              <p class="border-t border-slate-100 px-5 py-4 text-sm leading-relaxed text-slate-600 dark:border-night-700 dark:text-slate-400">
                {field.detalle}
              </p>
            </details>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
        <h4 class="text-xs font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400">
          Destino del asegurado (campo 6)
        </h4>
        <ul class="mt-4 flex flex-wrap gap-2">
          {fua.destinationOptions.map((option) => (
            <li class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 dark:bg-night-900 dark:text-slate-300">
              {option}
            </li>
          ))}
        </ul>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
        <h4 class="text-xs font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400">
          Responsable de la atención (campo 11)
        </h4>
        <ol class="mt-4 grid grid-cols-2 gap-2">
          {fua.responsibleCodes.map((code, i) => (
            <li class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300">
              <span class="font-mono font-bold text-brand-600 dark:text-brand-300">{i + 1}</span>
              {code}
            </li>
          ))}
        </ol>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
        <h4 class="text-xs font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400">
          Indicaciones del formulario (RC)
        </h4>
        <ul class="mt-4 space-y-2.5">
          {fua.callouts.map((callout) => (
            <li class="flex gap-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              <Icon name="alert" class="mt-0.5 size-3.5 shrink-0 text-amber-500" />
              {callout}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
