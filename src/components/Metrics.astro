---
import Icon from './Icon.astro';
import { metrics } from '../data/content';
---

<section class="relative border-y border-slate-200 bg-white py-14 dark:border-night-700 dark:bg-night-900" aria-label="Métricas clave">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {metrics.map((metric) => (
        <article
          class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-5 transition-all hover:-translate-y-1 hover:border-brand-400/70 hover:shadow-lg hover:shadow-brand-500/10 dark:border-night-700 dark:bg-night-800"
        >
          <div
            class="absolute -top-8 -right-8 size-24 rounded-full bg-brand-500/10 transition-transform group-hover:scale-150"
            aria-hidden="true"
          ></div>
          <span class="relative grid size-10 place-items-center rounded-xl bg-brand-500/15 text-brand-600 dark:text-brand-300">
            <Icon name={metric.icon} class="size-5" />
          </span>
          <p class="font-display relative mt-4 text-3xl font-extrabold text-slate-900 dark:text-white">{metric.value}</p>
          <p class="relative mt-1 text-sm font-semibold text-slate-800 dark:text-slate-200">{metric.label}</p>
          <p class="relative mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{metric.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
