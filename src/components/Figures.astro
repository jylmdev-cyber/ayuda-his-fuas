---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { base, figures } from '../data/content';
---

<section
  id="figuras"
  class="scroll-mt-24 border-y border-slate-200 bg-white py-20 sm:py-24 dark:border-night-700 dark:bg-night-900"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Material original"
      title="Figuras del documento"
      description="Formularios y tablas tal como aparecen en el material de estudio. Haz clic para ampliar."
    />

    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {figures.map((figure, i) => (
        <figure class="group">
          <button
            type="button"
            data-figure-btn={String(i)}
            class="block w-full overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 text-left transition-all hover:-translate-y-1 hover:border-brand-400/70 hover:shadow-xl hover:shadow-brand-500/10 dark:border-night-700 dark:bg-night-800"
            aria-label={`Ampliar figura: ${figure.caption}`}
          >
            <div class="relative overflow-hidden bg-white dark:bg-night-950">
              <img
                src={`${base}${figure.src}`}
                alt={figure.alt}
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <span
                class="absolute top-3 left-3 rounded-full bg-night-950/80 px-3 py-1 text-[10px] font-bold tracking-widest text-brand-300 uppercase backdrop-blur"
              >
                {figure.tag}
              </span>
              <span
                class="absolute right-3 bottom-3 grid size-9 place-items-center rounded-xl bg-brand-600/90 text-white opacity-0 transition-opacity group-hover:opacity-100"
              >
                <Icon name="search" class="size-4" />
              </span>
            </div>
            <figcaption class="px-5 py-4 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              {figure.caption}
            </figcaption>
          </button>
        </figure>
      ))}
    </div>
  </div>

  <dialog
    id="figure-lightbox"
    class="m-auto w-auto max-w-[min(94vw,1100px)] rounded-3xl border border-slate-200 bg-white p-4 backdrop:bg-night-950/80 backdrop:backdrop-blur-sm dark:border-night-600 dark:bg-night-900"
  >
    <div class="flex items-center justify-between gap-4 pb-3">
      <p id="lightbox-caption" class="text-sm font-semibold text-slate-800 dark:text-slate-100"></p>
      <button
        type="button"
        id="lightbox-close"
        class="grid size-9 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 dark:border-night-600 dark:text-slate-300"
        aria-label="Cerrar figura ampliada"
      >
        <Icon name="close" class="size-4" />
      </button>
    </div>
    <img id="lightbox-img" src="" alt="" class="max-h-[75vh] w-full rounded-2xl object-contain" />
  </dialog>
</section>

<script define:vars={{ base, figures }}>
  const dialog = document.getElementById('figure-lightbox');
  const image = document.getElementById('lightbox-img');
  const caption = document.getElementById('lightbox-caption');

  document.querySelectorAll('[data-figure-btn]').forEach((button) => {
    button.addEventListener('click', () => {
      const figure = figures[Number(button.dataset.figureBtn)];
      if (!figure || !dialog || !image) return;
      image.src = base + figure.src;
      image.alt = figure.alt;
      if (caption) caption.textContent = figure.caption;
      dialog.showModal();
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
