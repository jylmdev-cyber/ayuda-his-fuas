---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { base, codeTables, cursoVida, site } from '../data/content';

const financiador = codeTables.find((t) => t.id === 'financiador');

const inputCls =
  'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 transition-colors focus:border-brand-400 focus:outline-none dark:border-night-600 dark:bg-night-900 dark:text-slate-100';
const labelCls = 'block text-xs font-semibold text-slate-700 dark:text-slate-200';
---

<Layout title={`Asistente de código prestacional | ${site.title}`}>
  <Navbar />
  <main>
    <section class="relative overflow-hidden border-b border-slate-200 dark:border-night-700">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50rem_24rem_at_20%_-20%,rgba(14,165,233,0.16),transparent)]"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <a
          href={base}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300"
        >
          <Icon name="chevron" class="size-3.5 rotate-90" />
          Volver a la guía
        </a>
        <h1 class="font-display mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">
          Asistente de código prestacional
        </h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Calcule la edad del asegurado a la fecha de atención y obtenga el código por curso de vida (301-305) que
          corresponde registrar en el campo <strong class="font-semibold">COD. PRESTA.</strong> de la sección "DE LA
          ATENCIÓN" del FUA, junto con las reglas de firma, coexistencia y exclusión de registro fragmentado, y los
          sugeridos de la Hoja HIS.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[380px,1fr]">
        <form
          id="as-form"
          class="space-y-5 self-start rounded-3xl border border-slate-200 bg-white p-6 lg:sticky lg:top-24 dark:border-night-700 dark:bg-night-800"
          novalidate
        >
          <div>
            <label for="as-fechanac" class={labelCls}>Fecha de nacimiento del asegurado</label>
            <input id="as-fechanac" name="as-fechanac" type="date" class={inputCls} />
          </div>
          <div>
            <label for="as-fechatencion" class={labelCls}>Fecha de la atención (ítem 7)</label>
            <input id="as-fechatencion" name="as-fechatencion" type="date" class={inputCls} />
          </div>
          <div>
            <label for="as-tipo" class={labelCls}>Tipo de actividad</label>
            <select id="as-tipo" name="as-tipo" class={inputCls}>
              <option value="atencion">Atención de salud</option>
              <option value="app">Actividad Preventivo Promocional (APP)</option>
              <option value="aaa">Actividad en Animales (AAA)</option>
            </select>
          </div>
          <div>
            <label for="as-fin" class={labelCls}>Financiador (ítem 9)</label>
            <select id="as-fin" name="as-fin" class={inputCls}>
              <option value="">Seleccione…</option>
              {financiador?.rows.map((row) => (
                <option value={row.code} selected={row.code === '2'}>
                  {row.code} — {row.label}
                </option>
              ))}
            </select>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
              El FUA y el código por curso de vida aplican con financiador 2 = SIS.
            </p>
          </div>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 has-checked:border-brand-500 has-checked:bg-brand-500/10 dark:border-night-600 dark:text-slate-200">
            <input id="as-gestante" name="as-gestante" type="checkbox" class="size-4 accent-brand-600" />
            Gestante (ítem 8.3)
          </label>
        </form>

        <div id="as-result" class="space-y-4" aria-live="polite"></div>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {cursoVida.codes.map((code) => (
          <article
            class="rounded-2xl border border-slate-200 bg-white p-5 text-center transition-colors hover:border-brand-400/70 dark:border-night-700 dark:bg-night-800"
          >
            <p class="font-display bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-3xl font-extrabold text-transparent">
              {code.codigo}
            </p>
            <p class="mt-2 text-xs leading-snug font-semibold text-slate-800 dark:text-slate-100">{code.nombre}</p>
            <p class="mt-2 inline-block rounded-full bg-brand-500/15 px-3 py-1 text-[11px] font-semibold text-brand-700 dark:text-brand-300">
              {code.rango}
            </p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { initAsistente } from '../scripts/asistente';
  initAsistente();
</script>
