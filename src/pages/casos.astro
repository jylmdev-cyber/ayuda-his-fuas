---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { base, site } from '../data/content';
---

<Layout title={`Casos de auditoría de la Hoja HIS | ${site.title}`}>
  <Navbar />
  <main>
    <section class="relative overflow-hidden border-b border-slate-200 dark:border-night-700">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50rem_24rem_at_40%_-20%,rgba(244,63,94,0.12),transparent)]"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <a
          href={base}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300"
        >
          <Icon name="chevron" class="size-3.5 rotate-90" />
          Volver a la guía
        </a>
        <h1 class="font-display mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">
          Casos de auditoría de la Hoja HIS
        </h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Como responsable de estadística, revise hojas HIS con errores sembrados: marque los casilleros que considere
          erróneos y contraste su auditoría con el motor de reglas del documento técnico. Cada hallazgo incluye la
          norma que lo sustenta.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div id="casos-cards" class="grid gap-5 md:grid-cols-2"></div>

      <div id="caso-panel" class="mt-10 hidden">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
          <h2 id="caso-titulo" class="font-display text-xl font-bold text-slate-900 dark:text-white"></h2>
          <p id="caso-contexto" class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400"></p>
          <div id="caso-hoja" class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-night-600 dark:bg-night-900"></div>
        </div>

        <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
          <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">
            Marque los casilleros con registro erróneo
          </h3>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Considere errores y observaciones del control de calidad. Los falsos positivos también descuentan.
          </p>
          <div id="caso-check" class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div>
          <div class="mt-6 text-center">
            <button
              id="caso-verificar"
              type="button"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-600 to-accent-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:-translate-y-0.5"
            >
              <Icon name="check" class="size-4" />
              Verificar auditoría
            </button>
          </div>
        </div>

        <div id="caso-result" class="mt-6 space-y-3"></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { initCasos } from '../scripts/casos';
  initCasos();
</script>
