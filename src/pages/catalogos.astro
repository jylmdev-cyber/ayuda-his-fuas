---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { base, codeTables, cursoVida, productionFormulas, site } from '../data/content';

const financiador = codeTables.find((t) => t.id === 'financiador');
const inputCls =
  'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 focus:border-brand-400 focus:outline-none dark:border-night-600 dark:bg-night-900 dark:text-slate-100';
const chipCls =
  'cursor-pointer rounded-full border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-600 transition-colors has-checked:border-brand-500 has-checked:bg-brand-500/15 has-checked:text-brand-700 dark:border-night-600 dark:text-slate-300 dark:has-checked:text-brand-300';
---

<Layout title={`Biblioteca de codificación sanitaria | ${site.title}`}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Biblioteca de Codificación Sanitaria',
      description: 'Catálogos oficiales CIE-10 MINSA y CPMS con búsqueda unificada, vigencia normativa y enlaces al simulador de la Hoja HIS.',
      inLanguage: 'es-PE',
      isPartOf: { '@type': 'WebSite', name: site.title, url: base },
      hasPart: [
        { '@type': 'WebPage', name: 'Capítulos del CIE-10 MINSA', url: `${base}catalogos/cie10/` },
        { '@type': 'SoftwareApplication', name: 'Simulador de llenado de la Hoja HIS', url: `${base}simulador/`, applicationCategory: 'EducationalApplication' },
      ],
    })}
  />
  <Navbar />
  <main>
    <section class="relative overflow-hidden border-b border-slate-200 dark:border-night-700">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_26rem_at_50%_-20%,rgba(14,165,233,0.16),transparent)]"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <a href={base} class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300">
          <Icon name="chevron" class="size-3.5 rotate-90" />
          Volver a la guía
        </a>
        <h1 class="font-display mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">
          Biblioteca de Codificación Sanitaria
        </h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Catálogos independientes con búsqueda unificada: diagnósticos CIE-10 MINSA con control de vigencia según la
          RM 447-2024-MINSA, procedimientos CPMS (RM 550-2023-MINSA), reglas HIS y prestaciones FUA. Un diagnóstico no
          es un procedimiento ni un código prestacional: cada consulta se mantiene en su catálogo.
        </p>
        <p id="cat-estado" class="mt-4 text-xs font-semibold text-brand-700 dark:text-brand-300" aria-live="polite">
          Cargando catálogos oficiales…
        </p>
        <div id="cat-recientes" class="mt-4"></div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div
        role="tablist"
        aria-label="Catálogos"
        class="flex flex-wrap gap-1 rounded-2xl border border-slate-200 bg-slate-100/80 p-1.5 dark:border-night-700 dark:bg-night-800/80"
      >
        {[
          { id: 'cie10', label: 'CIE-10 · Diagnósticos' },
          { id: 'cpms', label: 'CPMS · Procedimientos' },
          { id: 'uni', label: 'Búsqueda unificada' },
          { id: 'his', label: 'HIS · Reglas y LAB' },
          { id: 'fua', label: 'FUA · Prestaciones' },
        ].map((tab, i) => (
          <button
            type="button"
            role="tab"
            data-cat-tab={tab.id}
            aria-selected={i === 0}
            class:list={[
              'flex-1 rounded-xl px-4 py-2.5 text-xs font-semibold transition-all sm:text-sm',
              i === 0
                ? 'bg-white text-brand-700 shadow-sm dark:bg-night-700 dark:text-brand-300'
                : 'text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300',
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- ---------------- CIE-10 ---------------- -->
      <div data-cat-panel="cie10" class="mt-8">
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-night-700 dark:bg-night-800">
          <div class="grid gap-3 lg:grid-cols-[1fr,240px,220px]">
            <input id="cie-q" type="search" class={inputCls} placeholder="Código, diagnóstico o término (ej.: hipertensión, I10, dengue…)" aria-label="Buscar en CIE-10" />
            <select id="cie-cap" class={inputCls} aria-label="Filtrar por capítulo"></select>
            <select id="cie-est" class={inputCls} aria-label="Filtrar por estrategia sanitaria"></select>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por estado del código">
            {[
              { v: 'todos', l: 'Todos' },
              { v: 'vigente', l: 'Vigentes' },
              { v: 'cesado', l: 'Cese de uso' },
              { v: 'adicion', l: 'Adición RM 447' },
            ].map((opcion, i) => (
              <label class={chipCls}>
                <input type="radio" name="cie-estado" value={opcion.v} checked={i === 0} class="sr-only" />
                {opcion.l}
              </label>
            ))}
            <button
              id="cie-favs"
              type="button"
              class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:text-amber-600 dark:border-night-600 dark:text-slate-300"
            >
              ★ Solo favoritos
            </button>
          </div>
        </div>
        <p id="cie-conteo" class="mt-4 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400"></p>
        <ul id="cie-lista" class="mt-3 space-y-2.5"></ul>
        <div class="mt-4 text-center">
          <button id="cie-mas" type="button" class="hidden rounded-xl border border-slate-300 px-6 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-400 hover:text-brand-700 dark:border-night-600 dark:text-slate-200">
            Mostrar más resultados
          </button>
        </div>
      </div>

      <!-- ---------------- CPMS ---------------- -->
      <div data-cat-panel="cpms" class="mt-8 hidden">
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-night-700 dark:bg-night-800">
          <div class="grid gap-3 lg:grid-cols-[1fr,260px,260px]">
            <input id="cpms-q" type="search" class={inputCls} placeholder="Código o procedimiento (ej.: anestesia, 59401…)" aria-label="Buscar en CPMS" />
            <select id="cpms-grupo" class={inputCls} aria-label="Filtrar por grupo CPMS"></select>
            <select id="cpms-seccion" class={inputCls} aria-label="Filtrar por sección CPMS"></select>
          </div>
        </div>
        <p id="cpms-conteo" class="mt-4 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400"></p>
        <ul id="cpms-lista" class="mt-3 space-y-2.5"></ul>
        <div class="mt-4 text-center">
          <button id="cpms-mas" type="button" class="hidden rounded-xl border border-slate-300 px-6 py-2.5 text-sm font-semibold text-slate-700 hover:border-accent-400 hover:text-accent-600 dark:border-night-600 dark:text-slate-200">
            Mostrar más resultados
          </button>
        </div>
      </div>

      <!-- ---------------- Unificada ---------------- -->
      <div data-cat-panel="uni" class="mt-8 hidden">
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-night-700 dark:bg-night-800">
          <input id="uni-q" type="search" class={inputCls} placeholder="Busca a la vez en CIE-10 y CPMS…" aria-label="Búsqueda unificada" />
          <p class="mt-2 text-[11px] text-slate-500 dark:text-slate-400">
            Útil para distinguir de un vistazo el diagnóstico (CIE-10) del procedimiento (CPMS) asociados a un término.
          </p>
        </div>
        <p id="uni-conteo" class="mt-4 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400"></p>
        <ul id="uni-lista" class="mt-3 space-y-2.5"></ul>
      </div>

      <!-- ---------------- HIS ---------------- -->
      <div data-cat-panel="his" class="mt-8 hidden">
        <div class="grid gap-6 lg:grid-cols-3">
          {codeTables.map((tabla) => (
            <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
              <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">{tabla.titulo}</h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">{tabla.itemRef}</p>
              <ul class="mt-4 space-y-2">
                {tabla.rows.map((fila) => (
                  <li class="flex gap-2 text-xs text-slate-600 dark:text-slate-300">
                    <span class="font-mono font-bold text-brand-600 dark:text-brand-300">{fila.code}</span>
                    {fila.label}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {[productionFormulas.intramural, productionFormulas.extramural].map((modo, i) => (
            <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
              <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">
                {i + 1}. {modo.title}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{modo.detail}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {modo.formulas.map((formula) => (
                  <code class="rounded-lg bg-slate-100 px-3 py-1.5 font-mono text-xs font-semibold text-slate-800 dark:bg-night-900 dark:text-slate-100">{formula}</code>
                ))}
              </div>
            </article>
          ))}
        </div>
        <p class="mt-6 text-center text-sm">
          <a href={`${base}#items`} class="font-semibold text-brand-700 hover:underline dark:text-brand-300">
            Ver las reglas completas de los 22 ítems y el uso del VALOR LAB en la guía →
          </a>
        </p>
      </div>

      <!-- ---------------- FUA ---------------- -->
      <div data-cat-panel="fua" class="mt-8 hidden">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {cursoVida.codes.map((codigo) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 text-center dark:border-night-700 dark:bg-night-800">
              <p class="font-display bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-3xl font-extrabold text-transparent">{codigo.codigo}</p>
              <p class="mt-2 text-xs leading-snug font-semibold text-slate-800 dark:text-slate-100">{codigo.nombre}</p>
              <p class="mt-2 inline-block rounded-full bg-brand-500/15 px-3 py-1 text-[11px] font-semibold text-brand-700 dark:text-brand-300">{codigo.rango}</p>
            </article>
          ))}
        </div>
        <article class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 dark:border-night-700 dark:bg-night-800">
          <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">Financiadores que determinan el FUA</h3>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            {financiador?.rows.map((fila) => (
              <li class="flex gap-2 rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-700 dark:bg-night-900 dark:text-slate-300">
                <span class="font-mono font-bold text-brand-600 dark:text-brand-300">{fila.code}</span>
                {fila.label}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
            Solo el financiador 2 (SIS) genera el Formato Único de Atención; los códigos 3 a 9 exigen convenio vigente.
          </p>
        </article>
        <p class="mt-6 text-center text-sm">
          <a href={`${base}asistente/`} class="font-semibold text-brand-700 hover:underline dark:text-brand-300">
            Calcular el código prestacional por edad con el asistente →
          </a>
        </p>
      </div>
    </section>
  </main>
  <Footer />

  <dialog
    id="cat-dialog"
    class="m-auto w-auto max-w-[min(94vw,640px)] rounded-3xl border border-slate-200 bg-white p-6 backdrop:bg-night-950/80 backdrop:backdrop-blur-sm dark:border-night-600 dark:bg-night-900"
  >
    <div class="flex items-start justify-between gap-4">
      <div id="cat-dialog-body" class="min-w-0 flex-1"></div>
      <button
        id="cat-dialog-close"
        type="button"
        class="grid size-9 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 dark:border-night-600 dark:text-slate-300"
        aria-label="Cerrar ficha"
      >
        <Icon name="close" class="size-4" />
      </button>
    </div>
    <div class="mt-5 flex gap-2">
      <button id="cat-dialog-copy" type="button" class="rounded-xl bg-gradient-to-r from-brand-600 to-accent-500 px-5 py-2.5 text-xs font-semibold text-white shadow-md shadow-brand-500/25">
        Copiar código
      </button>
    </div>
  </dialog>
</Layout>

<script>
  import { initCatalogos } from '../scripts/catalogos';
  initCatalogos();
</script>
