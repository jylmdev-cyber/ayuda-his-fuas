---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { base, site } from '../data/content';

const decks = ['todos', 'Hoja HIS', 'Códigos', 'FUA', 'Curso de vida', 'Normativa'];

const btnCls =
  'inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-400 hover:text-brand-700 dark:border-night-600 dark:text-slate-200 dark:hover:text-brand-300';
---

<Layout title={`Modo estudio: flashcards y quiz | ${site.title}`}>
  <Navbar />
  <main>
    <section class="relative overflow-hidden border-b border-slate-200 dark:border-night-700">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50rem_24rem_at_60%_-20%,rgba(20,184,166,0.16),transparent)]"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <a
          href={base}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300"
        >
          <Icon name="chevron" class="size-3.5 rotate-90" />
          Volver a la guía
        </a>
        <h1 class="font-display mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">Modo estudio</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Repase el documento con tarjetas de memoria generadas desde el contenido (ítems, códigos, campos del FUA,
          curso de vida y hechos normativos) o evalúese con un quiz de diez preguntas con explicaciones. Su progreso
          queda guardado en este navegador.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div
        role="tablist"
        aria-label="Modos de estudio"
        class="flex gap-1 rounded-2xl border border-slate-200 bg-slate-100/80 p-1.5 dark:border-night-700 dark:bg-night-800/80"
      >
        <button
          type="button"
          role="tab"
          data-est-tab="flash"
          aria-selected="true"
          class="flex-1 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-brand-700 shadow-sm dark:bg-night-700 dark:text-brand-300"
        >
          Flashcards
        </button>
        <button
          type="button"
          role="tab"
          data-est-tab="quiz"
          aria-selected="false"
          class="flex-1 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 dark:text-slate-400"
        >
          Quiz
        </button>
      </div>

      <div id="estudio-form" class="mt-8">
        <div data-est-panel="flash">
          <div class="flex flex-wrap items-center gap-3">
            <label for="fc-deck" class="text-xs font-semibold text-slate-700 dark:text-slate-200">Mazo:</label>
            <select
              id="fc-deck"
              class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm dark:border-night-600 dark:bg-night-900 dark:text-slate-100"
            >
              {decks.map((deck) => (
                <option value={deck}>{deck === 'todos' ? 'Todos los mazos' : deck}</option>
              ))}
            </select>
            <button id="fc-shuffle" type="button" class={btnCls}>
              <Icon name="layers" class="size-4" />
              Mezclar
            </button>
            <button id="fc-reset" type="button" class={btnCls}>
              <Icon name="close" class="size-4" />
              Reiniciar progreso
            </button>
            <p id="fc-progress" class="ml-auto text-xs font-semibold text-brand-700 dark:text-brand-300"></p>
          </div>

          <div
            id="fc-card"
            class="flip relative mt-6 min-h-[280px] cursor-pointer select-none"
            role="button"
            tabindex="0"
            aria-label="Voltear tarjeta"
          >
            <div class="flip-inner relative h-full min-h-[280px]">
              <div
                class="flip-face absolute inset-0 flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-8 shadow-lg shadow-slate-900/5 dark:border-night-600 dark:bg-night-800"
              >
                <span
                  id="fc-tag"
                  class="self-start rounded-full bg-brand-500/15 px-3 py-1 text-[10px] font-bold tracking-widest text-brand-700 uppercase dark:text-brand-300"
                ></span>
                <p id="fc-front" class="font-display text-xl leading-snug font-bold text-slate-900 dark:text-white"></p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">Clic, espacio o enter para voltear · flechas para navegar</p>
              </div>
              <div
                class="flip-face flip-back absolute inset-0 flex items-center rounded-3xl border border-brand-500/40 bg-gradient-to-br from-brand-500/10 to-accent-500/10 p-8"
              >
                <p id="fc-back" class="text-sm leading-relaxed text-slate-700 dark:text-slate-200"></p>
              </div>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <button id="fc-prev" type="button" class={btnCls} aria-label="Tarjeta anterior">
              <Icon name="chevron" class="size-4 rotate-90" />
              Anterior
            </button>
            <button
              id="fc-review"
              type="button"
              class="inline-flex items-center gap-2 rounded-xl border border-amber-500/50 px-5 py-2.5 text-sm font-semibold text-amber-700 transition-colors hover:bg-amber-500/10 dark:text-amber-300"
            >
              Repasar
            </button>
            <button
              id="fc-know"
              type="button"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-600 to-accent-500 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand-500/25 transition-transform hover:-translate-y-0.5"
            >
              La sabía
            </button>
            <button id="fc-next" type="button" class={btnCls} aria-label="Tarjeta siguiente">
              Siguiente
              <Icon name="chevron" class="size-4 -rotate-90" />
            </button>
          </div>

          <div class="mx-auto mt-6 max-w-md">
            <p id="fc-count" class="text-center text-xs font-semibold text-slate-500 dark:text-slate-400"></p>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-night-700">
              <div id="fc-bar" class="h-full rounded-full bg-gradient-to-r from-brand-500 to-accent-500 transition-all" style="width:0%"></div>
            </div>
          </div>
        </div>

        <div data-est-panel="quiz" class="hidden">
          <div id="qz-root"></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .flip {
    perspective: 1400px;
  }
  .flip-inner {
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .flip.flipped .flip-inner {
    transform: rotateY(180deg);
  }
  .flip-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { initEstudio } from '../scripts/estudio';
  initEstudio();
</script>
