---
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { base, site } from '../../../data/content';

type Fila = [string, string, string, number, number, string, number, number, number];

export function getStaticPaths() {
  const archivo = path.join(process.cwd(), 'public', 'data', 'cie10.json');
  if (!existsSync(archivo)) return [];
  const datos = JSON.parse(readFileSync(archivo, 'utf8'));
  const porCapitulo = new Map<number, Fila[]>();
  for (const fila of datos.items as Fila[]) {
    if (fila[3] < 0) continue;
    porCapitulo.set(fila[3], [...(porCapitulo.get(fila[3]) ?? []), fila]);
  }
  return (datos.capitulos as string[]).map((titulo, indice) => {
    const romano = (/Cap[ií]tulo ([IVXLCX]+)/i.exec(titulo)?.[1] ?? String(indice + 1)).toLowerCase();
    return {
      params: { capitulo: `capitulo-${romano}` },
      props: {
        titulo,
        filas: porCapitulo.get(indice) ?? [],
        grupos: datos.grupos as string[],
        estrategias: datos.estrategias as string[],
        referencias: datos.referencias as string[],
      },
    };
  });
}

interface Props {
  titulo: string;
  filas: Fila[];
  grupos: string[];
  estrategias: string[];
  referencias: string[];
}

const { titulo, filas, grupos, estrategias, referencias } = Astro.props as Props;

const porGrupo = new Map<number, Fila[]>();
for (const fila of filas) {
  porGrupo.set(fila[4], [...(porGrupo.get(fila[4]) ?? []), fila]);
}

const cesados = filas.filter((f) => f[7] === 1).length;
const estrategiasDe = (mascara: number): string[] => estrategias.filter((_, bit) => (mascara & (1 << bit)) !== 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${titulo} — CIE-10 MINSA`,
  description: `Códigos, descripciones y estado de vigencia del capítulo ${titulo} del catálogo CIE-10 MINSA, con control de vigencia según la RM 447-2024-MINSA.`,
  inLanguage: 'es-PE',
  isPartOf: { '@type': 'WebSite', name: site.title, url: base },
  about: { '@type': 'DefinedTermSet', name: 'CIE-10 MINSA' },
  numberOfItems: filas.length,
};
---

<Layout
  title={`${titulo} | CIE-10 MINSA`}
  description={`Códigos y descripciones del capítulo ${titulo} del CIE-10 MINSA (${filas.length.toLocaleString('es-PE')} códigos${cesados ? `, ${cesados} con cese de uso` : ''}) según REUNIS y la RM 447-2024-MINSA.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <nav class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400" aria-label="Ruta de navegación">
      <a href={base} class="hover:text-brand-700 dark:hover:text-brand-300">Inicio</a>
      <Icon name="chevron" class="size-3 -rotate-90" />
      <a href={`${base}catalogos/`} class="hover:text-brand-700 dark:hover:text-brand-300">Biblioteca</a>
      <Icon name="chevron" class="size-3 -rotate-90" />
      <a href={`${base}catalogos/cie10/`} class="hover:text-brand-700 dark:hover:text-brand-300">CIE-10</a>
      <Icon name="chevron" class="size-3 -rotate-90" />
      <span class="font-semibold text-slate-700 dark:text-slate-200">{titulo.split(':')[0]}</span>
    </nav>

    <h1 class="font-display mt-4 text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">{titulo}</h1>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {filas.length.toLocaleString('es-PE')} códigos del catálogo oficial CIE-10 MINSA (REUNIS, VOLUMEN VIGENTE)
      {cesados ? `, incluidos ${cesados} con cese de uso dispuesto por la RM 447-2024-MINSA` : ''}. Página estática de
      consulta: use el <a href={`${base}catalogos/`} class="font-semibold text-brand-700 hover:underline dark:text-brand-300">explorador interactivo</a>
      para búsqueda por sinónimos, estrategias sanitarias y favoritos.
    </p>

    {[...porGrupo.entries()].map(([grupoIdx, grupoFilas]) => (
      <section class="mt-10">
        <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">
          {grupoIdx >= 0 ? grupos[grupoIdx] : 'Códigos sin grupo asignado'}
        </h2>
        <ul class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white dark:divide-night-700 dark:border-night-700 dark:bg-night-800">
          {grupoFilas.map((fila) => (
            <li id={fila[0]} class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3">
              <span class="font-mono text-sm font-extrabold text-brand-700 dark:text-brand-300">{fila[0]}</span>
              {fila[1] && <span class="font-mono text-[11px] text-slate-400">OMS {fila[1]}</span>}
              <span class="min-w-0 flex-1 text-sm text-slate-700 dark:text-slate-200">{fila[2]}</span>
              {fila[7] === 1 && (
                <span class="rounded-full bg-rose-500/15 px-2.5 py-0.5 text-[10px] font-bold text-rose-700 dark:text-rose-300">CESE DE USO</span>
              )}
              {fila[7] === 2 && (
                <span class="rounded-full bg-accent-500/15 px-2.5 py-0.5 text-[10px] font-bold text-accent-700 dark:text-accent-300">ADICIÓN RM 447</span>
              )}
              {estrategiasDe(fila[6]).length > 0 && (
                <span class="rounded-full bg-brand-500/10 px-2.5 py-0.5 text-[10px] font-semibold text-brand-700 dark:text-brand-300">
                  {estrategiasDe(fila[6]).join(', ')}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mt-12 text-xs text-slate-500 dark:text-slate-400">
      Fuente: {site.org} · REUNIS (VOLUMEN VIGENTE) · RM 447-2024-MINSA{referencias.length ? ` · ${referencias.join(' · ')}` : ''}.
      Herramienta educativa: no reemplaza al aplicativo HIS MINSA ni garantiza la aceptación de una prestación por el SIS.
    </p>
  </main>
</Layout>
