---
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { base, site } from '../../../data/content';

const archivo = path.join(process.cwd(), 'public', 'data', 'cie10.json');
const datos = existsSync(archivo) ? JSON.parse(readFileSync(archivo, 'utf8')) : null;

type Fila = [string, string, string, number, number, string, number, number, number];

const porCapitulo = new Map<number, Fila[]>();
if (datos) {
  for (const fila of datos.items as Fila[]) {
    if (fila[3] < 0) continue;
    porCapitulo.set(fila[3], [...(porCapitulo.get(fila[3]) ?? []), fila]);
  }
}

const romanoDe = (titulo: string): string =>
  (/Cap[ií]tulo ([IVXLCX]+)/i.exec(titulo)?.[1] ?? '').toLowerCase();

const capitulos = datos
  ? (datos.capitulos as string[]).map((titulo, indice) => ({
      indice,
      titulo,
      slug: `capitulo-${romanoDe(titulo) || indice + 1}`,
      total: porCapitulo.get(indice)?.length ?? 0,
      cesados: (porCapitulo.get(indice) ?? []).filter((f) => f[7] === 1).length,
    }))
  : [];
---

<Layout
  title="Capítulos del CIE-10 MINSA | Biblioteca de Codificación"
  description="Índice de los 22 capítulos del catálogo CIE-10 MINSA con sus códigos vigentes, extensiones nacionales y ceses de uso según la RM 447-2024-MINSA."
>
  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <a href={`${base}catalogos/`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300">
      <Icon name="chevron" class="size-3.5 rotate-90" />
      Volver a la biblioteca
    </a>
    <h1 class="font-display mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">
      Capítulos del CIE-10 MINSA
    </h1>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      Páginas estáticas generadas en la compilación desde el catálogo oficial (REUNIS) con el control de vigencia de
      la RM 447-2024-MINSA. Cada capítulo lista sus grupos, códigos y descripciones sin necesidad de JavaScript.
    </p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {capitulos.map((cap) => (
        <li>
          <a
            href={`${base}catalogos/cie10/${cap.slug}/`}
            class="block rounded-3xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-1 hover:border-brand-400/70 hover:shadow-lg hover:shadow-brand-500/10 dark:border-night-700 dark:bg-night-800"
          >
            <p class="font-display text-sm font-extrabold text-brand-600 dark:text-brand-300">{cap.titulo.split(':')[0]}</p>
            <p class="mt-1 text-sm leading-snug font-semibold text-slate-800 dark:text-slate-100">
              {cap.titulo.split(':').slice(1).join(':').trim() || cap.titulo}
            </p>
            <p class="mt-3 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
              {cap.total.toLocaleString('es-PE')} códigos{cap.cesados ? ` · ${cap.cesados} con cese de uso` : ''}
            </p>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-xs text-slate-500 dark:text-slate-400">
      Fuente: {site.org} · REUNIS, VOLUMEN VIGENTE · RM 447-2024-MINSA. Herramienta educativa: no reemplaza al
      aplicativo HIS MINSA.
    </p>
  </main>
</Layout>
